# Template for a development installation from source.
# Copy it to .env at the repository root. Every variable is described in docs/configuration.md.

# Backend Configuration
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
# Used by docker-compose.local-db.yml; keep aligned with DATABASE_URL
POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=taskmaster_dev
POSTGRES_DB=taskmaster
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=taskmaster_local_db
# Update the credentials in this URL if you change the values above
DATABASE_URL=postgresql://taskmaster:taskmaster_dev@localhost:5432/taskmaster
# Max size of the PostgreSQL connection pool (optional, default 10)
# DATABASE_POOL_MAX=10
# Max duration of one SQL statement in ms (optional, 0 = no limit). Keep it generous for exports.
# DATABASE_STATEMENT_TIMEOUT_MS=0

# Redis
# Used by docker-compose.local-db.yml; keep aligned with REDIS_URL
REDIS_PORT=6379
REDIS_CONTAINER_NAME=taskmaster_local_redis
# Default for local: redis://localhost:6379
# Default for Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Security
# AUTH_SECRET must be at least 32 characters. Generate it with: openssl rand -base64 32
AUTH_SECRET=your-32-characters-minimum-secret-key-change-it
# BOOTSTRAP_SECRET protects the first admin setup. Generate it with: openssl rand -base64 24
BOOTSTRAP_SECRET=your-bootstrap-secret-min-16-chars
# Grace window of the token rotation (two tabs refreshing at once)
# Code default: 30 s. Min: 1 s. Max: 60 s.
AUTH_GRACE_WINDOW_ENABLED=true
AUTH_GRACE_WINDOW_SECONDS=10

# First start
# There is no default admin account. Use the setup wizard at:
#   http://localhost:5173/setup
# It creates the first SUPER_ADMIN account.

# Storage & Backups
# Required in production. Generate it with: openssl rand -base64 32
BACKUP_STORAGE_PATH=./backups
BACKUP_ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars
# Should match POSTGRES_CONTAINER_NAME when backups rely on the Docker pg_dump fallback
BACKUP_DOCKER_CONTAINER=taskmaster_local_db

# CORS (Required in Production)
CORS_ORIGIN=http://localhost:5173

# Reverse proxy: keep `loopback` when the app is reached directly.
# Required for rate limiting and the audit log to use `X-Forwarded-For`
# behind a proxy.
TRUST_PROXY=loopback

# Comma-separated IPs (exact match) exempt from the per-IP rate limit on /auth/login
# and /auth/refresh. Useful for NAT/proxy exits shared by many legitimate
# users. The per-account (username) protection still applies.
# AUTH_LOCKOUT_IP_WHITELIST=203.0.113.5,198.51.100.42

# Observability
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Application Limits
PROCEDURE_MAX_SIZE_MB=5

# Web Push (VAPID): browser push notifications
# Generate the keys with: npx web-push generate-vapid-keys (a pair is generated at first use if left empty)
# VAPID_PUBLIC_KEY=BExamplePublicKeyBase64UrlEncoded...
# VAPID_PRIVATE_KEY=ExamplePrivateKeyBase64UrlEncoded...
# VAPID_CONTACT=mailto:admin@example.com

# Source installations compare the local version with the official GitHub releases.
# Forks only: override the official upstream if you develop a fork.
# VERSION_CHECK_REPO=your-org/taskmaster
