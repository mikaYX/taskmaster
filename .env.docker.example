# Template for the docker-compose.yml stack.
# Copy it to .env and fill in the values. The compose file contains no hard-coded URL or credential.
# Every variable is described in docs/configuration.md.
#
# REQUIRED: AUTH_SECRET must be at least 32 characters, otherwise the app exits with an error.
#     Generate one: openssl rand -base64 32


# Postgres (postgres service of the compose file)
# POSTGRES_USER and POSTGRES_PASSWORD must not be empty: otherwise the app's
# DATABASE_URL is invalid and the API cannot connect.
POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmaster
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=taskmaster_db

# Redis (redis service of the compose file)
REDIS_PORT=6379
REDIS_CONTAINER_NAME=taskmaster_redis

# App (app service of the compose file)
APP_CONTAINER_NAME=taskmaster_app

# Backend Configuration
PORT=3000
NODE_ENV=production
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database: built by docker-compose from POSTGRES_* (no DATABASE_URL needed here)
# Redis: same, injected by the compose file (redis://redis:6379)
# Max size of the PostgreSQL connection pool (optional, default 10)
# DATABASE_POOL_MAX=10
# Max duration of one SQL statement in ms (optional, 0 = no limit). Keep it generous for exports.
# DATABASE_STATEMENT_TIMEOUT_MS=0

# Security. REQUIRED: replace with a key of at least 32 characters (openssl rand -base64 32)
AUTH_SECRET=your-32-characters-minimum-secret-key-change-it
# At least 16 characters (openssl rand -base64 24). Required by the setup wizard to create the first admin.
BOOTSTRAP_SECRET=your-bootstrap-secret-min-16-chars
AUTH_GRACE_WINDOW_ENABLED=true
AUTH_GRACE_WINDOW_SECONDS=10

# CORS: the address users type in their browser (e.g. http://localhost:3000 when everything is on one port)
CORS_ORIGIN=http://localhost:3000

# Reverse proxy: keep `loopback` when the app is reached directly.
# With nginx/traefik/cloudflare in front, give the number of proxies
# in front of the app (e.g. TRUST_PROXY=1 for a single nginx) or the matching
# Express value (`loopback`, `linklocal`, an IP, or `true`).
# Required for rate limiting and the audit log to use `X-Forwarded-For`.
TRUST_PROXY=loopback

# Comma-separated IPs (exact match) exempt from the per-IP rate limit on /auth/login
# and /auth/refresh. Useful for NAT/proxy exits shared by many legitimate
# users. The per-account (username) protection still applies.
# AUTH_LOCKOUT_IP_WHITELIST=203.0.113.5,198.51.100.42

# Observability & Limits
LOG_LEVEL=info
PROCEDURE_MAX_SIZE_MB=5

# Storage & Backups. REQUIRED: replace with a key of at least 32 characters (openssl rand -base64 32)
# Keep a copy of BACKUP_ENCRYPTION_KEY outside the server: backups cannot be restored without it.
BACKUP_STORAGE_PATH=./backups
BACKUP_ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars
# Match POSTGRES_CONTAINER_NAME if you override it
BACKUP_DOCKER_CONTAINER=taskmaster_db

# Web Push (optional; a key pair is generated at first use if left empty)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com

# Update source, detected automatically:
# - official GitHub releases for a source installation
# - Docker Hub tags of TASKMASTER_IMAGE for a Docker Hub installation
#
# Forks only: override the official upstream if you publish your own fork
# VERSION_CHECK_REPO=your-org/taskmaster
# VERSION_CHECK_DOCKER_IMAGE=your-dockerhub-user/taskmaster

# Docker image to run (default: official Docker Hub upstream)
TASKMASTER_IMAGE=mikaxy/taskmaster:latest
