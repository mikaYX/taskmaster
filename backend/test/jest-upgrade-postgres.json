{
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "upgrade-backup.postgres-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^otplib$": "<rootDir>/../src/__mocks__/otplib.ts"
  }
}
